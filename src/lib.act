#
#
import math
import float_decode

class StopCode(object):
    def __init__(self):
        pass

class TaggedItem(object):
    tag: u64
    item: value

    def __init__(self, tag: u64, item: value):
        self.tag = tag
        self.item = item

def decode(data: bytes) -> ?value:
    item, remainder = decode_item(data)

    if len(remainder) > 0:
        raise ValueError(f'Spare bytes after decoding item {item}: {remainder}')

    return item
    
def encode(val: ?value) -> bytes:
    return b''


def decode_item(data: bytes) -> (?value, bytes):
    if len(data) == 0:
        raise ValueError('Cannot decode empty payload')

    head_byte: int = data[0]

    major_type = (head_byte & 0xe0) >> 5
    addl_info = head_byte & 0x1f
    data = data[1:]

    item: ?value = 0

    arg: u64 = u64(addl_info)
    indefinite = False

    if addl_info > 23:
        if addl_info < 28:
            upper_bytes = 2**(addl_info - 24) - 1
            arg = u64(data[0])
            data = data[1:]
            for i in range(upper_bytes):
                arg = arg << 8
                arg |= u64(data[0])
                data = data[1:]
            
        elif addl_info < 31:
            raise ValueError(f'Invalid additional info value {addl_info}')

        else:
            indefinite = True

    if major_type == 0x0:
        item = arg
    elif major_type == 0x1:
        if arg < 0x8000000000000000:
            item = -1 - int(arg)
        else:
            item = -1 - bigint(arg)
    elif major_type == 0x2:
        item, data = decode_bytestr(arg, data, indefinite)
    elif major_type == 0x3:
        item, data = decode_str(arg, data, indefinite)
    elif major_type == 0x4:
        item, data = decode_array(arg, data, indefinite)
    elif major_type == 0x5:
        item, data = decode_map(arg, data, indefinite)
    elif major_type == 0x6:
        tagged_item, data = decode_item(data)
        item = decode_tagged(arg, tagged_item)
    elif major_type == 0x7:
        item, data = decode_extended(addl_info, arg, data)

    return item, data

def decode_bytestr(length, data, indefinite) -> (bytes, bytes):
    item = b''

    if not indefinite:
        i: u64 = 0
        while i < length:
            item += bytes([data[0]])
            data = data[1:]
            i += 1
        return item, data
    else:
        while True:
            nextchunk, data = decode_item(data)

            if isinstance(nextchunk, bytes):
                item += nextchunk
            elif isinstance(nextchunk, StopCode):
                return item, data
            else:
                raise ValueError(f'Invalid item {item} encountered in indefinite string')
        return b'', data

def decode_str(length, data, indefinite) -> (str, bytes):
    bytestr = b''

    if not indefinite:
        i: u64 = 0
        while i < length:
            bytestr += bytes([data[0]])
            data = data[1:]
            i += 1
        return bytestr.decode(), data
    else:
        item = ''
        while True:
            nextchunk, data = decode_item(data)

            if isinstance(nextchunk, str):
                item += nextchunk
            elif isinstance(nextchunk, StopCode):
                return item, data
            else:
                raise ValueError(f'Invalid item {item} encountered in indefinite string')

        return '', data

def decode_array(length, data, indefinite) -> (list[?value], bytes):
    item = []

    if not indefinite:
        i: u64 = 0
        while i < length:
            element, remaining_data = decode_item(data)
            if isinstance(element, StopCode):
                raise ValueError(f'Stop code encountered in definite-length array')
            item.append(element)
            data = remaining_data
            i += 1
    else:
        while True:
            element, data = decode_item(data)

            if isinstance(element, StopCode):
                break

            item.append(element)

    return item, data

def decode_map(length, data, indefinite) -> (?value, bytes):
    item: ?value = None

    if not indefinite:

        if length > 0:
            i: u64 = 0
            first_key, remaining_data = decode_item(data)
            val, remaining_data = decode_item(remaining_data)
            if isinstance(first_key, int):
                map = {}
                map[first_key] = val
                data = remaining_data
                while i < (length - 1):
                    key, remaining_data = decode_item(data)
                    val, remaining_data = decode_item(remaining_data)
                    if isinstance(key, int):
                        map[key] = val
                        data = remaining_data
                    else:
                        raise ValueError(f'Type mismatch between key {key} and int-keyed map')
                    i += 1
                item = map

            elif isinstance(first_key, u64):
                map = {}
                map[first_key] = val
                data = remaining_data
                while i < (length - 1):
                    key, remaining_data = decode_item(data)
                    val, remaining_data = decode_item(remaining_data)
                    if isinstance(key, u64):
                        map[key] = val
                        data = remaining_data
                    else:
                        raise ValueError(f'Type mismatch between key {key} and u64-keyed map')
                item = map
            elif isinstance(first_key, bigint):
                map = {}
                map[first_key] = val
                data = remaining_data
                while i < (length - 1):
                    key, remaining_data = decode_item(data)
                    val, remaining_data = decode_item(remaining_data)
                    if isinstance(key, bigint):
                        map[key] = val
                        data = remaining_data
                    else:
                        raise ValueError(f'Type mismatch between key {key} and bigint-keyed map')
                    i += 1
                item = map
            elif isinstance(first_key, str):
                map = {}
                map[first_key] = val
                data = remaining_data
                while i < (length - 1):
                    key, remaining_data = decode_item(data)
                    val, remaining_data = decode_item(remaining_data)
                    if isinstance(key, str):
                        map[key] = val
                        data = remaining_data
                    else:
                        raise ValueError(f'Type mismatch between key {key} and str-keyed map')

                    i += 1
                item = map
            elif isinstance(first_key, bytes):
                map = {}
                map[first_key] = val
                data = remaining_data
                while i < (length - 1):
                    key, remaining_data = decode_item(data)
                    val, remaining_data = decode_item(remaining_data)
                    if isinstance(key, bytes):
                        map[key] = val
                        data = remaining_data
                    else:
                        raise ValueError(f'Type mismatch between key {key} and bytes-keyed map')
                    i += 1
                item = map
            else:
                raise ValueError(f'Unsupported type for key {first_key}')
        else:
            item = {}

    else:

        first_key, remaining_data = decode_item(data)

        val: ?value = None
        if not isinstance(first_key, StopCode):
            val, remaining_data = decode_item(remaining_data)

        if isinstance(first_key, int):
            map = {}
            map[first_key] = val
            data = remaining_data
            while True:
                key, remaining_data = decode_item(data)
                if isinstance(key, int):
                    val, remaining_data = decode_item(remaining_data)
                    map[key] = val
                    data = remaining_data
                elif isinstance(key, StopCode):
                    data = remaining_data
                    break
                else:
                    raise ValueError(f'Type mismatch between key {key} and int-keyed map')
            item = map

        elif isinstance(first_key, u64):
            map = {}
            map[first_key] = val
            data = remaining_data
            while True:
                key, remaining_data = decode_item(data)
                if isinstance(key, u64):
                    val, remaining_data = decode_item(remaining_data)
                    map[key] = val
                    data = remaining_data
                elif isinstance(key, StopCode):
                    data = remaining_data
                    break
                else:
                    raise ValueError(f'Type mismatch between key {key} and u64-keyed map')
            item = map
        elif isinstance(first_key, bigint):
            map = {}
            map[first_key] = val
            data = remaining_data
            while True:
                key, remaining_data = decode_item(data)
                if isinstance(key, bigint):
                    val, remaining_data = decode_item(remaining_data)
                    map[key] = val
                    data = remaining_data
                elif isinstance(key, StopCode):
                    data = remaining_data
                    break
                else:
                    raise ValueError(f'Type mismatch between key {key} and bigint-keyed map')
            item = map
        elif isinstance(first_key, str):
            map = {}
            map[first_key] = val
            data = remaining_data
            while True:
                key, remaining_data = decode_item(data)
                if isinstance(key, str):
                    val, remaining_data = decode_item(remaining_data)
                    map[key] = val
                    data = remaining_data
                elif isinstance(key, StopCode):
                    data = remaining_data
                    break
                else:
                    raise ValueError(f'Type mismatch between key {key} and str-keyed map')

            item = map
        elif isinstance(first_key, bytes):
            map = {}
            map[first_key] = val
            data = remaining_data
            while True:
                key, remaining_data = decode_item(data)
                if isinstance(key, bytes):
                    val, remaining_data = decode_item(remaining_data)
                    map[key] = val
                    data = remaining_data
                elif isinstance(key, StopCode):
                    data = remaining_data
                    break
                else:
                    raise ValueError(f'Type mismatch between key {key} and bytes-keyed map')
            item = map
        elif isinstance(first_key, StopCode):
            data = remaining_data
        else:
            raise ValueError(f'Unsupported type for key {first_key}')

        if item is None:
            item = {}
                
    return item, data

def decode_extended(addl_info, arg, data) -> (?value, bytes):
    item: ?value = 0

    if addl_info < 20:
        item = arg
    elif addl_info == 20:
        item = False
    elif addl_info == 21:
        item = True
    elif addl_info == 22:
        item = None
    elif addl_info == 23:
        item = 23
    elif addl_info == 24:
        if arg < 32:
            raise ValueError(f'Invalid value for two-bye simple value sequence: {item}')
        item = arg
    elif addl_info == 25:
        item = float_decode.decode_float16(arg)
    elif addl_info == 26:
        item = float_decode.decode_float32(arg)
    elif addl_info == 27:
        item = float_decode.decode_float64(arg)
    elif addl_info == 31:
        item = StopCode()
    else:
        raise ValueError(f'Invalid additional info value for major type 7: {addl_info}')

    return item, data

def decode_tagged(arg, tagged_item) -> value:
    if arg == 2:
        if isinstance(tagged_item, bytes):
            item: bigint = 0

            for byte in tagged_item:
                item |= bigint(byte)
                item = item << 8
            item = item >> 8

            return item

    elif arg == 3:
        if isinstance(tagged_item, bytes):
            item: bigint = 0

            for byte in tagged_item:
                item |= bigint(byte)
                item = item << 8
            item = item >> 8

            return -1 - item

    raise ValueError(f'Unsupported tagged item with tag {arg} and body {tagged_item}')
