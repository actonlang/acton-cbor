import math

class StopCode(object):
    def __init__(self):
        pass

class TaggedItem(object):
    tag: u64
    item: value

    def __init__(self, tag: u64, item: value):
        self.tag = tag
        self.item = item

def decode(data: bytes) -> value:
    item, remainder = decode_item(data)

    if len(remainder) > 0:
        raise ValueError(f'Spare bytes after decoding item {item}: {remainder}')

    return item
    
def encode(val: value) -> bytes:
    return b''


def decode_item(data: bytes) -> (value, bytes):
    if len(data) == 0:
        raise ValueError('Cannot decode empty payload')

    head_byte: int = data[0]

    major_type = (head_byte & 0xe0) >> 5
    addl_info = head_byte & 0x1f
    data = data[1:]

    item: value = 0

    arg: u64 = u64(addl_info)
    indefinite = False

    if addl_info > 23:
        if addl_info < 28:
            upper_bytes = 2**(addl_info - 24) - 1
            arg = u64(data[0])
            data = data[1:]
            for i in range(upper_bytes):
                arg = arg << 8
                arg |= u64(data[0])
                data = data[1:]
            
        elif addl_info < 31:
            raise ValueError(f'Invalid additional info value {addl_info}')

        else:
            indefinite = True

    if major_type == 0x0:
        item = arg
    elif major_type == 0x1:
        if arg < 0x8000000000000000:
            item = -1 - int(arg)
        else:
            item = -1 - bigint(arg)
    elif major_type == 0x2:
        item, data = decode_bytestr(arg, data, indefinite)
    elif major_type == 0x3:
        item = decode_str(arg, data, indefinite)
    elif major_type == 0x4:
        item = decode_array(arg, data, indefinite)
    elif major_type == 0x5:
        item = decode_map(arg, data, indefinite)
    elif major_type == 0x6:
        tagged_item, data = decode_item(data)
        item = decode_tagged(arg, tagged_item)
    elif major_type == 0x7:
        item, data = decode_extended(arg, data)

    return item, data

def decode_bytestr(length, data, indefinite) -> (bytes, bytes):
    item = b''

    if not indefinite:
        i: u64 = 0
        while i < length:
            item += bytes([data[0]])
            data = data[1:]
            i += 1
        return item, data
    else:
        return b'', data

def decode_str(length, data, indefinite) -> str:
    return ''

def decode_array(length, data, indefinite) -> list[value]:
    item = []

    if not indefinite:
        i: u64 = 0
        while i < length:
            element, remaining_data = decode_item(data)
            if isinstance(element, StopCode):
                raise ValueError(f'Stop code encountered in definite-length array')
            item.append(element)
            data = remaining_data
            i += 1

    return item

def decode_map(length, data, indefinite) -> dict[str, value]:
    return {}

def decode_extended(arg, data) -> (value, bytes):
    item: value = 0

    if arg < 20:
        item = arg
    elif arg == 20:
        item = False
    elif arg == 21:
        item = True
    elif arg == 22:
        #item = None
        pass
    elif arg == 23:
        item = 23
    elif arg == 24:
        item_byte = data[0]
        if item_byte < 32:
            raise ValueError(f'Invalid value for two-bye simple value sequence: {item}')
        item = item_byte
        data = data[1:]

    return item, data

def decode_float16(data) -> float:
    NotImplemented

def decode_float32(data) -> float:
    NotImplemented

def decode_float64(data) -> float:
    NotImplemented

def decode_tagged(arg, tagged_item) -> value:
    if arg == 2:
        if isinstance(tagged_item, bytes):
            item: bigint = 0

            for byte in tagged_item:
                item |= bigint(byte)
                item = item << 8
            item = item >> 8

            return item

    elif arg == 3:
        if isinstance(tagged_item, bytes):
            item: bigint = 0

            for byte in tagged_item:
                item |= bigint(byte)
                item = item << 8
            item = item >> 8

            return -item

    raise ValueError(f'Unsupported tagged item with tag {arg} and body {tagged_item}')
